rules_version = '2';

// ===============================================================
//  PROTOTIPO de reglas de seguridad  —  App de vales de gasolina
// ===============================================================
//
//  ⚠️  ADVERTENCIA IMPORTANTE
//  A petición explícita, esta colección permite LECTURA y ESCRITURA
//  SIN AUTENTICACIÓN. El "PIN" de la app es sólo del lado del cliente y
//  NO protege estos datos: cualquiera que conozca el projectId puede leer,
//  crear o modificar documentos directamente dentro de las validaciones.
//
//  Estas reglas hacen lo ÚNICO posible sin autenticación: validar la FORMA
//  y el TAMAÑO de cada documento para limitar spam, basura y ataques de
//  agotamiento (payloads gigantes). NO controlan QUIÉN accede.
//
//  Si algún día los datos dejan de ser de confianza, la solución real es
//  Firebase Authentication + reglas basadas en el usuario. Con gusto te ayudo.
//
// ===============================================================
//  Modelo de datos asumido
// ===============================================================
//
//  Colección: vales
//  ID de documento: automático (addDoc)
//  Campos:
//    - nombre:         string   (requerido, 1..100)
//    - categoria:      string   (requerido, en ['Empleado','Familia','Socio'])
//    - monto:          number   (requerido, en [200, 300, 500, 1000, 4000])
//    - fechaVale:      timestamp(requerido; fecha del vale elegida por el usuario)
//    - createdAt:      timestamp(requerido; serverTimestamp() del sistema)
//    - registradoPor:  string   (requerido, 1..100)
//    - notas:          string   (opcional, 0..500)
//    - anulado:        bool      (opcional; borrado suave)
//    - anuladoEn:      timestamp (opcional; cuándo se anuló)
//    - batchId:        string    (opcional, <=64; id del lote para dedupe)
//    - qrCode:         string    (opcional, <=64; código del vale: COMBUSA-{FOLIO}
//                                 si sale del inventario, o el código de prueba
//                                 SPECTRO-FUEL-{AÑO}-{8 CHARS} si no)
//    - folio:          string    (opcional, <=16, sólo dígitos; folio real del
//                                 vale físico de Combusa asignado a este vale)
//    - vencimiento:    string    (opcional, "YYYY-MM-DD"; vencimiento del vale
//                                 físico asignado)
//    - fecha:          timestamp (LEGACY; documentos antiguos usaban este campo
//                                 en vez de 'fechaVale'. Se permite para poder
//                                 actualizarlos/anularlos.)
//
//  Colección: inventario
//  ID de documento: EL FOLIO (p. ej. "117765"). Al usar el folio como ID,
//                   Firestore impide por construcción importar dos veces el
//                   mismo vale físico.
//  Campos:
//    - folio:          string   (requerido, 1..16, sólo dígitos; == ID del doc)
//    - monto:          number   (requerido, en [200, 300, 500, 1000])
//    - status:         string   (requerido, en ['disponible',
//                                'revision_requerida','asignado','canjeado',
//                                'vencido'])
//    - vencimiento:    string   (requerido pero puede ser null; "YYYY-MM-DD")
//    - qrImageBase64:  string   (requerido, <=80000; PNG en base64 del QR real
//                                extraído del PDF de Combusa. ~6KB por vale)
//    - decodeError:    bool     (sólo si requiere revisión; siempre true)
//    - decodedPayload: string   (sólo si requiere revisión; null o <=2048;
//                                texto devuelto por jsQR)
//    - asignadoA:      string   (o null; persona a la que se asignó)
//    - asignadoEn:     timestamp(o null; cuándo se asignó)
//    - batchId:        string   (o null, <=64; lote de registro que lo asignó)
//    - importadoEn:    timestamp(requerido; serverTimestamp() de la importación)
//    - importadoPor:   string   (requerido, 1..100)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --------- Funciones de ayuda ---------
    // 'fecha' (legacy) se incluye para que los documentos ANTIGUOS —guardados
    // con 'fecha' en lugar de 'fechaVale'— sigan pudiendo actualizarse/anularse.
    function hasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly(
        ['nombre', 'categoria', 'monto', 'fechaVale', 'fecha', 'createdAt',
         'registradoPor', 'notas', 'anulado', 'anuladoEn', 'batchId', 'qrCode',
         'folio', 'vencimiento']
      );
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalNotas() {
      return !('notas' in request.resource.data) ||
             (request.resource.data.notas is string &&
              request.resource.data.notas.size() <= 500);
    }

    function isValidOptionalAnulado() {
      return (!('anulado' in request.resource.data) ||
              request.resource.data.anulado is bool) &&
             (!('anuladoEn' in request.resource.data) ||
              request.resource.data.anuladoEn is timestamp);
    }

    function isValidOptionalBatchId() {
      return !('batchId' in request.resource.data) ||
             (request.resource.data.batchId is string &&
              request.resource.data.batchId.size() <= 64);
    }

    function isValidOptionalQrCode() {
      return !('qrCode' in request.resource.data) ||
             (request.resource.data.qrCode is string &&
              request.resource.data.qrCode.size() <= 64);
    }

    // Folio del vale físico de Combusa asignado a este vale (si hubo inventario).
    function isValidOptionalFolio() {
      return (!('folio' in request.resource.data) ||
              (request.resource.data.folio is string &&
               request.resource.data.folio.size() >= 1 &&
               request.resource.data.folio.size() <= 16 &&
               request.resource.data.folio.matches('^[0-9]+$'))) &&
             (!('vencimiento' in request.resource.data) ||
              (request.resource.data.vencimiento is string &&
               request.resource.data.vencimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    // Campos comunes a create y update.
    function hasValidCommonFields() {
      return request.resource.data.keys().hasAll(
               ['nombre', 'categoria', 'monto', 'registradoPor']) &&
             isValidString('nombre', 1, 100) &&
             (request.resource.data.categoria in ['Empleado', 'Familia', 'Socio']) &&
             (request.resource.data.monto in [200, 300, 500, 1000, 4000]) &&
             isValidString('registradoPor', 1, 100) &&
             isValidOptionalNotas() &&
             isValidOptionalAnulado() &&
             isValidOptionalBatchId() &&
             isValidOptionalQrCode() &&
             isValidOptionalFolio();
    }

    // CREATE: esquema NUEVO estricto (siempre fechaVale + createdAt).
    function isValidNewVale() {
      return hasOnlyAllowedFields() &&
             hasValidCommonFields() &&
             request.resource.data.fechaVale is timestamp &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.createdAt == request.time;
    }

    // UPDATE: tolera documentos ANTIGUOS (campo 'fecha' en vez de 'fechaVale',
    // y sin 'createdAt'). Así se pueden anular vales guardados con el esquema
    // anterior sin relajar la validación de los documentos nuevos.
    function isValidUpdatedVale() {
      return hasOnlyAllowedFields() &&
             hasValidCommonFields() &&
             (request.resource.data.fechaVale is timestamp ||
              request.resource.data.fecha is timestamp) &&
             (!('createdAt' in request.resource.data) ||
              request.resource.data.createdAt is timestamp);
    }

    function isValidValeAnnulment() {
      return isValidUpdatedVale() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['anulado', 'anuladoEn']) &&
             request.resource.data.anulado == true &&
             request.resource.data.anuladoEn is timestamp &&
             request.resource.data.anuladoEn == request.time;
    }

    // --------- Colección de vales ---------
    match /vales/{valeId} {
      // Lectura pública (solicitada explícitamente; datos no sensibles).
      allow read: if true;

      // Escritura pública, pero SÓLO si el documento cumple el esquema.
      allow create: if isValidNewVale();
      // El borrado suave (anular) es un 'update'; tolera documentos antiguos.
      allow update: if isValidValeAnnulment();

      // Sin borrado físico: se usa borrado suave (anulado = true).
      allow delete: if false;
    }

    // --------- Inventario de vales físicos de Combusa ---------
    // Mismo modelo de seguridad que 'vales': acceso público, validado por FORMA.
    // Lo que estas reglas SÍ garantizan:
    //   · un folio no se puede reimportar ni reescribir (los datos del vale
    //     físico son inmutables una vez importados);
    //   · una actualización sólo puede tocar los campos de asignación, así que
    //     nadie puede "reciclar" un folio cambiándole el monto o el QR.
    match /inventario/{folio} {

      function invHasOnlyAllowedFields() {
        return request.resource.data.keys().hasOnly(
          ['folio', 'monto', 'status', 'vencimiento', 'qrImageBase64',
           'decodeError', 'decodedPayload', 'asignadoA', 'asignadoEn',
           'batchId', 'importadoEn', 'importadoPor']
        );
      }

      // Campos que pueden faltar o ser null (aún sin asignar).
      function invNullableString(field, maxLen) {
        return !(field in request.resource.data) ||
               request.resource.data[field] == null ||
               (request.resource.data[field] is string &&
                request.resource.data[field].size() <= maxLen);
      }

      function invNullableTimestamp(field) {
        return !(field in request.resource.data) ||
               request.resource.data[field] == null ||
               request.resource.data[field] is timestamp;
      }

      // "YYYY-MM-DD" o null (hay PDFs sin fecha de vencimiento legible).
      function invValidVencimiento() {
        return !('vencimiento' in request.resource.data) ||
               request.resource.data.vencimiento == null ||
               (request.resource.data.vencimiento is string &&
                request.resource.data.vencimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }

      function invValidDecodeMetadata() {
        return (!('decodeError' in request.resource.data) ||
                request.resource.data.decodeError is bool) &&
               (!('decodedPayload' in request.resource.data) ||
                request.resource.data.decodedPayload == null ||
                (request.resource.data.decodedPayload is string &&
                 request.resource.data.decodedPayload.size() <= 2048)) &&
               // Un folio bloqueado para revisión siempre conserva el
               // resultado de jsQR (null si no hubo decodificación).
               (request.resource.data.status != 'revision_requerida' ||
                (request.resource.data.keys()
                   .hasAll(['decodeError', 'decodedPayload']) &&
                 request.resource.data.decodeError == true));
      }

      // Validador completo compartido por CREATE y UPDATE: evita convertir un
      // documento válido en uno corrupto mediante una actualización parcial.
      function invIsValidDocument() {
        return invHasOnlyAllowedFields() &&
               request.resource.data.keys().hasAll(
                 ['folio', 'monto', 'status', 'qrImageBase64',
                  'importadoEn', 'importadoPor']) &&
               // El ID del documento ES el folio: sin esto se podrían crear
               // duplicados del mismo vale físico con IDs distintos.
               request.resource.data.folio == folio &&
               request.resource.data.folio is string &&
               request.resource.data.folio.size() >= 1 &&
               request.resource.data.folio.size() <= 16 &&
               request.resource.data.folio.matches('^[0-9]+$') &&
               (request.resource.data.monto in [200, 300, 500, 1000]) &&
               (request.resource.data.status in
                 ['disponible', 'revision_requerida', 'asignado',
                  'canjeado', 'vencido']) &&
               invValidVencimiento() &&
               invValidDecodeMetadata() &&
               // Imagen del QR: ~6KB por vale; el tope evita payloads gigantes.
               request.resource.data.qrImageBase64 is string &&
               request.resource.data.qrImageBase64.size() >= 1 &&
               request.resource.data.qrImageBase64.size() <= 80000 &&
               invNullableString('asignadoA', 100) &&
               invNullableTimestamp('asignadoEn') &&
               invNullableString('batchId', 64) &&
               request.resource.data.importadoEn is timestamp &&
               request.resource.data.importadoPor is string &&
               request.resource.data.importadoPor.size() >= 1 &&
               request.resource.data.importadoPor.size() <= 100;
      }

      function invIsValidNew() {
        return invIsValidDocument() &&
               (request.resource.data.status in
                 ['disponible', 'revision_requerida']) &&
               ((request.resource.data.status == 'disponible' &&
                 !('decodeError' in request.resource.data) &&
                 !('decodedPayload' in request.resource.data)) ||
                (request.resource.data.status == 'revision_requerida' &&
                 request.resource.data.decodeError == true)) &&
               request.resource.data.asignadoA == null &&
               request.resource.data.asignadoEn == null &&
               request.resource.data.batchId == null &&
               request.resource.data.importadoEn == request.time;
      }

      // Aprobación manual: sólo desbloquea el status. decodeError y el payload
      // permanecen inmutables como evidencia de la revisión.
      function invIsApproval() {
        return resource.data.status == 'revision_requerida' &&
               request.resource.data.status == 'disponible' &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status']);
      }

      // Asignación normal desde el pool disponible.
      function invIsAssignment() {
        return resource.data.status == 'disponible' &&
               request.resource.data.status == 'asignado' &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'asignadoA', 'asignadoEn', 'batchId']) &&
               request.resource.data.asignadoA is string &&
               request.resource.data.asignadoA.size() >= 1 &&
               request.resource.data.asignadoA.size() <= 100 &&
               request.resource.data.asignadoEn is timestamp &&
               request.resource.data.asignadoEn == request.time &&
               request.resource.data.batchId is string &&
               request.resource.data.batchId.size() >= 1 &&
               request.resource.data.batchId.size() <= 64;
      }

      // Al anular un registro, el vale asignado vuelve al inventario.
      function invIsReturn() {
        return resource.data.status == 'asignado' &&
               request.resource.data.status == 'disponible' &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'asignadoA', 'asignadoEn', 'batchId']) &&
               request.resource.data.asignadoA == null &&
               request.resource.data.asignadoEn == null &&
               request.resource.data.batchId == null;
      }

      // UPDATE: los datos físicos y el resultado de jsQR son inmutables; sólo
      // se aceptan las tres transiciones usadas por la aplicación.
      function invIsValidUpdate() {
        return invIsValidDocument() &&
               (invIsApproval() || invIsAssignment() || invIsReturn());
      }

      // Lectura pública: la app necesita el QR y las existencias.
      allow read: if true;

      // 'create' sólo aplica si el documento NO existe: reimportar el mismo
      // folio es un 'update', que invIsValidUpdate() rechaza al cambiar campos
      // congelados.
      allow create: if invIsValidNew();
      allow update: if invIsValidUpdate();

      // Un vale físico importado no se borra: se marca 'canjeado' o 'vencido'.
      allow delete: if false;
    }

    // Todo lo demás: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
